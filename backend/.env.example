# --- Database ------------------------------------------------------------
# Local dev default (no Docker needed): sqlite:///./storage/app.db
# docker-compose: postgresql+psycopg2://sdoc:sdoc@postgres:5432/sdoc
DATABASE_URL=postgresql+psycopg2://sdoc:sdoc@postgres:5432/sdoc

# --- Simple auth (per spec: no enterprise auth) ---------------------------
APP_USERNAME=admin
APP_PASSWORD=admin123
# Set to 1 to bypass auth entirely while testing the API with curl/Postman.
DISABLE_AUTH=0

# --- AI layer --------------------------------------------------------------
# Optional. Only used as a fallback when the deterministic rules/NLP layer
# can't confidently classify an email or extract >=3 fields from a document.
# Leave unset to run the pipeline fully offline/deterministically.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Evaluation integration -------------------------------------------------
# Base URL of the organizers' scoring server (the sdoc-hackathon-docker
# package). Not part of this docker-compose — that's the organizers' service.
EVAL_SERVER_URL=http://eval-server:8000

# --- Storage ---------------------------------------------------------------
STORAGE_ROOT=/app/storage
